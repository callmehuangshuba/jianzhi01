# 统一换行符，避免 Windows/Linux 之间出现虚假 diff
* text=auto eol=lf

# 二进制文件禁止任何转换
*.jar  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.ico  binary

# 明确指定文本文件类型
*.java text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sh   text eol=lf

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
